[sub_resource type="GDScript" id="GDScript_x56xi"]
script/source = "extends Polygon2D

@onready var collision: CollisionPolygon2D = $CollisionPolygon2D

func _ready():
	if polygon.size() > 2:  # Ensure valid shape
		update_collision_shape()

func update_collision_shape():
	if collision:
		collision.polygon = polygon  # Sync collision with visual shape

func clip_terrain(explosion_shape):
	var result = Geometry2D.clip_polygons(polygon, explosion_shape)
	
	if result.is_empty():
		queue_free()  # Destroy if nothing remains
	else:
		polygon = result[0]  # Update the shape after clipping
		update_collision_shape()  # Update collision polygon to match
"

